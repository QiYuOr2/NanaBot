ADM_GROUP=1111111
BARK_KEY=xxxxx
NC_WS_URL=ws://127.0.0.1:1111
NC_ACCESS_TOKEN=your-token
# ADM_GROUP 只用于未配置 napcat.accounts 的旧单账号模式；多账号请在
# nana.config.yaml 的每个账号下分别配置 adminGroup。
# 多 QQ 时在 nana.config.yaml#napcat.accounts 里为第二个账号指定 accessTokenEnv，
# 例如 NC_ACCESS_TOKEN_2，然后在这里填入对应 token。
NC_WS_URL_2=ws://127.0.0.1:2222
NC_ACCESS_TOKEN_2=
NC_DEBUG=0
# 离线告警邮件（QQ 邮箱 SMTP，587 端口 STARTTLS）
SERVER_EMAIL=your-qq@qq.com
SERVER_EMAIL_PASSWORD=your-smtp-auth-code
# DeepSeek 直播摘要。下播后由机器人生成并发到开播通知群；词云页补生成也读这个变量，但不会发群。
DEEPSEEK_API_KEY=
