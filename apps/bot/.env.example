# 官方 QQ：与 NapCat 凭据独立。在 nana.config.yaml 的对应账号下设置 provider: official。
# 可手填，或运行 vp run @nana/bot#qq:bind [账号id] 扫码写入 apps/bot/.env。
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
# 多个官方机器人在 accounts[].official 中用 appIdEnv / appSecretEnv 指定独立变量。
# QQ_BOT_APP_ID_2=
# QQ_BOT_APP_SECRET_2=

# NapCat 凭据通过 accounts[].napcat 显式引用。
BARK_KEY=xxxxx
NC_WS_URL=ws://127.0.0.1:1111
NC_ACCESS_TOKEN=your-token
# 管理群在 nana.config.yaml 的每个账号下分别配置 adminGroup。
# 多 QQ 时在 accounts[].napcat 中指定独立的 wsUrlEnv / accessTokenEnv，
# 例如 NC_WS_URL_2 / NC_ACCESS_TOKEN_2，再在这里填写值。全量配置见 nana.config.yaml.example。
NC_WS_URL_2=ws://127.0.0.1:2222
NC_ACCESS_TOKEN_2=
NC_DEBUG=0
# 离线告警邮件（QQ 邮箱 SMTP，587 端口 STARTTLS）
SERVER_EMAIL=your-qq@qq.com
SERVER_EMAIL_PASSWORD=your-smtp-auth-code
# DeepSeek 直播摘要。下播后由机器人生成并发到开播通知群；词云页补生成也读这个变量，但不会发群。
DEEPSEEK_API_KEY=
