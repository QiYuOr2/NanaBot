{
  "name": "nanabot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:bot": "vp run @nana/bot#build",
    "build:site": "vp run @nana/site#build",
    "dev:site": "vp run @nana/site#dev",
    "app": "node scripts/app.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
